{
  "version": 2,
  "functions": {
    "api/webhook.js": {
      "maxDuration": 15
    },
    "api/cron/daily-giveaway.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/webhook", "destination": "/api/webhook" }
  ],
  "crons": [
    { "path": "/api/cron/daily-giveaway", "schedule": "0 9 * * *" }
  ]
}

